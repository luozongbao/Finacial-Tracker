# ==========================================================================
# .htaccess — document root rules for the Financial Tracker dev stack.
#
# LiteSpeed honours this file: the `docker` vhost template enables
# `rewrite { RewriteFile .htaccess }` and `autoLoadHtaccess 1`, so these
# rules behave identically in dev and in production.
#
# PURPOSE
#   The whole repository is mounted at the document root, which means every
#   file in it is reachable over HTTP unless it is denied here. Without these
#   rules the development server hands out:
#
#     /.env              -> the MariaDB root password from .env
#     /.git/config       -> the repository's git metadata
#     /database/*        -> schema and regression-test sources
#     /docs/issues/*     -> internal issue write-ups
#     /vendor/*          -> third-party library source
#     /composer.json     -> the dependency manifest
#     /composer.lock     -> the exact deployed dependency versions
#
#   Every rule below was verified against
#   litespeedtech/openlitespeed:1.9.4-lsphp85
#   (LiteSpeed 1.9.4 / LSPHP 8.5.12). See docs/issues/issue-003.md.
#
# IMPORTANT FOR THE APPLICATION IMPLEMENTER
#   The front-controller rewrite rules go in THIS file, below the deny block.
#   Keep the deny block intact — do not replace the file wholesale. A
#   regression test should assert that /.env still returns 403.
# ==========================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ---- Dotfiles --------------------------------------------------------
    # .env, .env.*, .git, .github, .gitignore, .htaccess, editor swap files.
    # .well-known/ stays reachable (it is a standard public path).
    RewriteRule "(^|/)\.(?!well-known)" - [F,L]

    # ---- Secrets and generated configuration -----------------------------
    # config.php is executed by PHP when it is included server-side, but the
    # direct request is denied as defence in depth.
    RewriteRule "^/?config\.php$" - [F,L]

    # ---- Internal source trees ------------------------------------------
    # None of these are entry points; they are included or read from disk.
    # views/ holds the PHP screens. They are rendered by the front controller
    # and never requested directly — a direct request would run a screen
    # outside the front controller, with no configuration loaded.
    RewriteRule "^/?database/"  - [F,L]
    RewriteRule "^/?includes/"  - [F,L]
    RewriteRule "^/?docker/"    - [F,L]
    RewriteRule "^/?vendor/"    - [F,L]
    RewriteRule "^/?views/"     - [F,L]

    # ---- Dependency manifest ---------------------------------------------
    # composer.json and composer.lock describe the dependency tree. They are
    # not secrets, but they are not part of the public site either — and a
    # lock file advertises exactly which library versions are deployed.
    RewriteRule "^/?composer\.(json|lock)$" - [F,L]

    # ---- Internal documentation -----------------------------------------
    # docs/mockup/ stays public: it is the UX deliverable, and it is also
    # served by the standalone mockup container.
    RewriteRule "^/?docs/issues/" - [F,L]

    # ---- Front controller -------------------------------------------------
    # Everything that is not a real file and not a real directory is handed
    # to index.php. Real files (install.php, assets/, docs/mockup/) are served
    # directly.
    #
    # These rules come AFTER the deny block on purpose: the deny rules use
    # [F,L] and must be evaluated first, so /.env and /database/ are refused
    # by the server and never reach the front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]

    # The document root is a directory, so the two conditions above skip it
    # and the bare root is left to the server's directory index. That works
    # on LiteSpeed (index.php is in the default DirectoryIndex), but it is
    # the server's choice, not ours. The root is the one URL that redirects
    # to /dashboard, so it is routed explicitly.
    RewriteRule ^$ index.php [QSA,L]
</IfModule>
