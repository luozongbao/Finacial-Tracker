# Copy this file to .env and adjust the values for your environment.
# Docker Compose reads .env automatically. .env is git-ignored — never commit
# real credentials.
#
#   cp .env.example .env
#
# NOTE: these variables configure the CONTAINERS only. Application code reads
# config.php and nothing else — no getenv(), no $_ENV, no .env parsing in
# includes/. See AGENTS.md, "Install and config contract".

# ---- Web server (app) ------------------------------------------------------
# Host port that maps to LiteSpeed's HTTP listener inside the container.
APP_PORT=8088

# Host port for the LiteSpeed WebAdmin console. Bound to 127.0.0.1 only.
OLS_ADMIN_PORT=7080

# ---- phpMyAdmin ------------------------------------------------------------
PHPMYADMIN_PORT=8090

# ---- Mockup viewer (static nginx, profile "mockup") -----------------------
# Different port from APP_PORT so the app and the mockups can run at the same
# time. Start it with:  docker compose up -d mockup
MOCKUP_PORT=8089

# ---- MariaDB ---------------------------------------------------------------
# These must match what you type into the install wizard
# (http://localhost:${APP_PORT}/install.php).
#
# Inside Docker the database host is "db" — the compose service name — NOT
# "localhost". Type "db" in the wizard's database-host field.
DB_NAME=financial_tracker
DB_USER=ft_user
DB_PASSWORD=ft_password

# Root password for the MariaDB container. Only used during database init
# and by the db client inside the container.
MYSQL_ROOT_PASSWORD=ft_root_password

# ---- SMTP (used by the account-verification and password-reset mailer) ----
# Optional for local development: leave them empty and the app must degrade
# gracefully (the mailer reports "mail not configured" instead of fataling).
# Set them here and type the same values into the wizard. The sender identity
# (MAIL_FROM / MAIL_FROM_NAME) is a config.php constant, not an env var — see
# config.template.php and docs/issues/issue-010.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
